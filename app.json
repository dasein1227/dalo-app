{
  "expo": {
    "name": "COONN",
    "slug": "coonn",
    "owner": "geniestudio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "coonn",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0524"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "locales": {
      "ar": "./locales/ar.json",
      "de": "./locales/de.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "hi": "./locales/hi.json",
      "id": "./locales/id.json",
      "it": "./locales/it.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "pt": "./locales/pt.json",
      "ru": "./locales/ru.json",
      "th": "./locales/th.json",
      "tr": "./locales/tr.json",
      "vi": "./locales/vi.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.geniestudio.coonn",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSPhotoLibraryUsageDescription": "Photo access is used to select profile, post, and chat images.",
        "NSPhotoLibraryAddUsageDescription": "Photo library access is used to save images and media to your device.",
        "NSLocationWhenInUseUsageDescription": "Location is used for nearby posts, beacons, and distance-based features.",
        "NSCameraUsageDescription": "Camera access is used to take profile, post, and chat photos.",
        "NSMicrophoneUsageDescription": "Microphone access is used when recording videos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:coonn.geniewise.net",
        "applinks:coonn.geniewise.net"
      ],
      "buildNumber": "1"
    },
    "android": {
      "package": "com.geniestudio.coonn",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "coonn"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "coonn.geniewise.net",
              "pathPrefix": "/add"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#111827",
          "mode": "production",
          "defaultChannel": "chat"
        }
      ],
      "expo-splash-screen",
      "expo-dev-client",
      "expo-localization",
      "expo-audio",
      "expo-video",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "enforceNavigationBarContrast": false
          }
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox",
          "RNMapboxMapsDownloadToken": "sk.eyJ1Ijoic2hpbnlvdW5namluIiwiYSI6ImNtanpuam1xdDVoZGYzZ3NjMmlha3JlOHYifQ.UnuTGk2nz3hn6XGImhvb5w"
        }
      ],
      "./plugins/with-coonn-rich-push",
      "expo-secure-store"
    ],
    "newArchEnabled": true,
