{
  "expo": {
    "name": "dalo",
    "slug": "dalo",
    "owner": "youngjin1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "dalo",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.youngjin1.daloapp",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "채팅에서 사진을 선택하여 전송하기 위해 사진 보관함 접근이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "사진을 저장하거나 전송 이력을 저장하기 위해 사진 보관함에 쓰기 권한이 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "내 주변 기능을 위해 현재 위치 정보가 필요합니다."
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "dalo",
              "host": "",
              "pathPrefix": "/auth"
            }
          ]
        }
      ],
      "package": "com.youngjin1.daloapp"
    },

    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#111827",
          "mode": "production"
        }
      ],
      "expo-splash-screen",
      "expo-dev-client",
      "expo-localization",
      "expo-audio",
      "expo-video",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "enforceNavigationBarContrast": false
          }
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox",
          "RNMapboxMapsDownloadToken": "sk.eyJ1Ijoic2hpbnlvdW5namluIiwiYSI6ImNtanpuam1xdDVoZGYzZ3NjMmlha3JlOHYifQ.UnuTGk2nz3hn6XGImhvb5w"
        }
      ]
    ],

    "newArchEnabled": true,

